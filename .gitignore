# SnapStudy AI - Environment & Secret Ignore Rules

# Streamlit secrets (NEVER commit your actual secrets file)
.streamlit/secrets.toml

# Virtual environments
venv/
.venv/
env/
ENV/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Environment variables
.env
.env.*

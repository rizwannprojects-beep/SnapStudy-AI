# ==============================================================================
# SnapStudy AI - Secrets Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file and rename it to: secrets.toml (in this exact .streamlit folder)
# 2. Replace the placeholder values below with your real credentials.
# 3. Keep secrets.toml private — it is already included in .gitignore.
# ==============================================================================

# Google Gemini API Key
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY = "your_gemini_api_key_here"

# (Optional) Preferred Gemini Vision model. Default is gemini-3.8-flash
GEMINI_MODEL = "gemini-3.8-flash"

# (Optional) Fallback Gemini Vision model if primary model encounters high demand (503)
GEMINI_FALLBACK_MODEL = "gemini-1.5-flash"

# Gmail SMTP Configuration for Email Summaries
# Note: For Gmail, use an "App Password" (NOT your regular Gmail password).
# How to get an App Password:
# 1. Go to your Google Account > Security.
# 2. Enable 2-Step Verification.
# 3. Under 2-Step Verification, select "App passwords".
# 4. Generate a password for "Mail" / "SnapStudy AI" and paste the 16-character code below.
SMTP_EMAIL = "your_sender_email@gmail.com"
SMTP_APP_PASSWORD = "your_16_character_app_password"
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = 587
